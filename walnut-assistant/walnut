def launch_effect(title: str, command: str, args: list[str] | None = None, quit_hint: str = "Ctrl+C") -> int:
    clear_screen()
    if not exists(command):
        print(f"{command} is missing")
        pause()
        return 1
    print(color(f"{title} quick keys:", PALETTE["screen"]))
    print(f"  {color(quit_hint, PALETTE['hint'])}    quit and return to Walnut")
    print()
    print(f"Launching {command}.")
    return stream([command_or_name(command), *(args or [])])


