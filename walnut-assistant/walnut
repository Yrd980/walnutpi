            choice_line("5", "Return to login", PALETTE["back"])
        print()
        print(f"  {color('q.', PALETTE['key'])} {color('Back to Walnut menu', PALETTE['back'])}")
        choice = input("\nSelect> ").strip().lower()
        if choice == "1":
            open_ai(None)
        elif choice == "2":
            notes_menu(None)
        elif choice == "3":
            play_menu(None)
        elif choice == "4":
            status(None)
            input("\nPress Enter...")
        elif choice == "5" and os.getenv("WALNUT_SESSION_MODE") == "local":
            return 2
        elif choice in {"q", "quit", "exit"}:
            return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description="Walnut Home")
    sub = parser.add_subparsers(dest="cmd")

    commands = {
        "status": status,
        "ai": open_ai,
        "notes": notes_menu,
        "play": play_menu,
        "video": open_video,
        "voice": voice,
        "today": today,
    }
    for name, func in commands.items():
        p = sub.add_parser(name)
        if name == "video":
            p.add_argument("mode", nargs="?", choices=["color", "gray", "still-color", "still-gray"], default="color")
        p.set_defaults(func=func)

    p_note = sub.add_parser("note")
    p_note.add_argument("text", nargs="*")
    p_note.set_defaults(func=note)

    return parser


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()
    if not args.cmd:
        return menu(args)
    return args.func(args)


if __name__ == "__main__":
    raise SystemExit(main())
