def run(cmd: list[str], check: bool = False) -> subprocess.CompletedProcess[str]:
    return subprocess.run(cmd, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, check=check)


def stream(cmd: list[str], env: dict[str, str] | None = None) -> int:
    try:
        current_env = os.environ.copy()
        path_parts = current_env.get("PATH", "").split(":")
        for directory in EXTRA_COMMAND_DIRS:
            directory_text = str(directory)
            if directory_text not in path_parts:
                path_parts.append(directory_text)
        current_env["PATH"] = ":".join(path_parts)
        if env:
            current_env.update(env)
        return subprocess.call(cmd, env=current_env)
    except FileNotFoundError:
        print(f"missing command: {cmd[0]}")
        return 127


def command_path(cmd: str) -> str | None:
    found = shutil.which(cmd)
    if found:
        return found
    for directory in EXTRA_COMMAND_DIRS:
        candidate = directory / cmd
        if candidate.exists() and os.access(candidate, os.X_OK):
            return str(candidate)
    return None


def exists(cmd: str) -> bool:
    return command_path(cmd) is not None


def command_or_name(cmd: str) -> str:
    return command_path(cmd) or cmd


def first_existing_path(candidates: list[Path | None], fallback: Path) -> Path:
    for path in candidates:
        if path is not None and path.exists():
            return path
    return fallback


def root_cmd(cmd: list[str]) -> list[str]:
    if os.geteuid() == 0:
        return cmd
    if exists("sudo"):
        return ["sudo", "-n", *cmd]
    return cmd


def section(title: str) -> None:
    print(color(f"\n== {title} ==", PALETTE["ai"]))


def color(text: str, code: str) -> str:
    if not COLOR_ENABLED:
        return text
    return f"\033[{code}m{text}\033[0m"


def title(text: str, code: str | None = None) -> None:
    print(color(text, code or PALETTE["home"]))


def choice_line(key: str, label: str, code: str) -> None:
    print(f"  {color(key + '.', PALETTE['key'])} {color(label, code)}")


def back_line() -> None:
