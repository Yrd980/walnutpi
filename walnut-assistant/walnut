def pause(prompt: str = "Press Enter...") -> None:
    input(f"\n{prompt}")


def clear_screen() -> None:
    os.system("clear")


def one_line(cmd: list[str], fallback: str = "-") -> str:
    try:
        out = run(cmd).stdout.strip()
        return out if out else fallback
    except Exception:
        return fallback


def music_dir() -> Path:
    return first_existing_path(MUSIC_DIR_CANDIDATES, HOME / "music-library")


def project_root() -> Path:
    return first_existing_path(PROJECT_ROOT_CANDIDATES, HOME / "projects" / "WalnutPi")


def prepare_music() -> tuple[Path, Path, Path]:
    current_music_dir = music_dir()
    MUSIC_LINK.parent.mkdir(parents=True, exist_ok=True)
    CMUS_PLAYLIST.parent.mkdir(parents=True, exist_ok=True)
    CMUS_HOME.mkdir(parents=True, exist_ok=True)
    CMUS_HOME.chmod(0o700)

    if current_music_dir.exists():
        try:
            if MUSIC_LINK.is_symlink() or MUSIC_LINK.is_file():
                MUSIC_LINK.unlink()
            if not MUSIC_LINK.exists():
                MUSIC_LINK.symlink_to(current_music_dir, target_is_directory=True)
        except OSError:
            pass

        tracks = sorted(
            str(path)
            for path in current_music_dir.rglob("*")
            if path.is_file() and path.suffix.lower() in MUSIC_EXTENSIONS
        )
        CMUS_PLAYLIST.write_text(
            "\n".join(tracks) + ("\n" if tracks else ""),
            encoding="utf-8",
        )

    CMUS_RC.write_text(
        "set mpris=false\n",
        encoding="utf-8",
    )

    return current_music_dir, MUSIC_LINK, CMUS_PLAYLIST


def cmus_env() -> dict[str, str]:
    env = {"CMUS_HOME": str(CMUS_HOME), "CMUS_SOCKET": str(CMUS_SOCKET)}
    runtime_dir = os.environ.get("XDG_RUNTIME_DIR")
    if runtime_dir and os.access(runtime_dir, os.W_OK | os.X_OK):
        return env

    fallback = HOME / ".cache" / "walnut-runtime"
    try:
        fallback.mkdir(parents=True, exist_ok=True)
        fallback.chmod(0o700)
    except OSError:
        return env
    env["XDG_RUNTIME_DIR"] = str(fallback)
    return env


def load_cmus_playlist_later(playlist: Path, env: dict[str, str]) -> None:
    if not exists("cmus-remote"):
        return
    loader_env = os.environ.copy()
    loader_env.update(env)
    loader = (
        'i=0; while [ "$i" -lt 80 ]; do '
        'if [ -S "$CMUS_SOCKET" ]; then '
        'cmus-remote --server "$CMUS_SOCKET" -l -c "$1" >/dev/null 2>&1 && '
        'cmus-remote --server "$CMUS_SOCKET" -P -c "$1" >/dev/null 2>&1 && '
        '{ cmus-remote --server "$CMUS_SOCKET" -C "view 3" >/dev/null 2>&1 || true; exit 0; }; '
        "fi; "
        'i=$((i + 1)); sleep 0.1; '
        "done"
    )
    subprocess.Popen(
        ["sh", "-c", loader, "walnut-cmus-loader", str(playlist)],
        env=loader_env,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


def launch_cmus() -> int:
    current_music_dir, current_music_link, current_playlist = prepare_music()
    env = cmus_env()
    clear_screen()
    print("cmus quick keys:")
    print("  2        library view")
    print("  3        playlist view")
    print("  5        file browser view")
    print("  Enter    add/play selected file")
    print("  c        pause/resume")
    print("  b        next track")
    print("  z        previous track")
    print("  + / -    volume")
    print("  q        quit")
    print()
    print("Music folder:")
    print(f"  {current_music_link} -> {current_music_dir}")
    print("\nLaunching cmus with WalnutMusic loaded. Use q to quit cmus.\n")

    if current_playlist.exists() and current_playlist.stat().st_size > 0:
        load_cmus_playlist_later(current_playlist, env)
        return stream(["cmus"], env=env)
    if current_music_link.exists():
        return stream(["cmus", str(current_music_link)], env=env)
    return stream(["cmus"], env=env)


