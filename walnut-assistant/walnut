def alsa_capture_source() -> str | None:
    if not exists("arecord"):
        return None
    out = run(["arecord", "-l"]).stdout
    for line in out.splitlines():
        match = re.search(r"card\s+(\d+):.*device\s+(\d+):", line)
        if match:
            return f"hw:{match.group(1)},{match.group(2)}"
    return None


def prepare_cava_config() -> Path | None:
    source = os.getenv("WALNUT_CAVA_SOURCE") or alsa_capture_source()
    if not source:
        return None

    CAVA_CONFIG.parent.mkdir(parents=True, exist_ok=True)
    CAVA_CONFIG.write_text(
        "\n".join(
            [
                "[general]",
                "framerate = 30",
                "",
                "[input]",
                "method = alsa",
                f"source = {source}",
                "",
                "[output]",
                "method = ncurses",
                "",
            ]
        ),
        encoding="utf-8",
    )
    return CAVA_CONFIG


def launch_music_visualizer() -> int:
